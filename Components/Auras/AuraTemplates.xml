<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Button name="DiabolicAuraTemplate" inherits="SecureActionButtonTemplate" virtual="true">
		<Size x="36" y="36"/>
		<Attributes>
			<Attribute name="type2" value="macro"/>
		</Attributes>
		<Scripts>
			<OnLoad>
				self:RegisterForClicks("AnyUp")
				DiabolicUI3:GetModule("Auras"):Embed(self)
				self:OnInitialize()
			</OnLoad>
			<PostClick>
				print("|cFFFFFF00[CLICK!]|r Button clicked:", self:GetName(), "macrotext2:", self:GetAttribute("macrotext2"))
			</PostClick>
		</Scripts>
	</Button>
</Ui>
