<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Button name="DiabolicAuraTemplate" inherits="SecureActionButtonTemplate" virtual="true">
		<Size x="36" y="36"/>
		<Attributes>
			<Attribute name="type" value="cancelaura"/>
			<Attribute name="type2" value="cancelaura"/>
			<Attribute name="unit" value="player"/>
		</Attributes>
		<Scripts>
			<OnLoad>
				self:RegisterForClicks("RightButtonUp")
				DiabolicUI3:GetModule("Auras"):Embed(self)
				self:OnInitialize()
			</OnLoad>
			<PreClick>
				print("|cFFFF0000[PreClick]|r", self:GetName(), "type:", self:GetAttribute("type"), "unit:", self:GetAttribute("unit"), "index:", self:GetAttribute("index"), "filter:", self:GetAttribute("filter"))
			</PreClick>
			<PostClick>
				print("|cFFFFFF00[PostClick]|r", self:GetName())
			</PostClick>
		</Scripts>
	</Button>
</Ui>
